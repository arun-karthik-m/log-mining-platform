# Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME="Log Mining Intelligence Platform"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Configuration (Neon)
# Get your connection string from Neon console: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/log_mining?sslmode=require

# Database Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Mining Algorithm Settings
MIN_SUPPORT=0.1
MIN_CONFIDENCE=0.5
N_CLUSTERS=5
CONTAMINATION=0.1

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
